{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "demo.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "WarpWiggleStylize",
    "inputs": {
      "warp_pattern": "horizontal_bands",
      "warp_strength": 0.05,
      "warp_frequency": 4.0,
      "wiggle_amplitude": 0.02,
      "wiggle_frequency": 6.0,
      "wiggle_axis": "both",
      "block_size": 48,
      "noise_amount": 0.05,
      "motion_speed": 0.15,
      "intensity_mode": "constant",
      "pulse_count": 4.0,
      "pulse_depth": 0.7,
      "chromatic_aberration": 0.06,
      "edge_mode": "reflection",
      "seed": 0,
      "images": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "HUDOverlay",
    "inputs": {
      "color_scheme": "rgb_glitch",
      "opacity": 0.9,
      "crosshair_count": 6,
      "bar_count": 8,
      "corner_brackets": true,
      "scanlines": false,
      "glitch_text": true,
      "text": "REC ● SYS//TIMESLICE",
      "jitter": 0.5,
      "flicker": 0.25,
      "line_width": 2,
      "seed": 0,
      "images": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "CreateVideo",
    "inputs": {
      "fps": [
        "2",
        2
      ],
      "images": [
        "4",
        0
      ],
      "audio": [
        "2",
        1
      ]
    }
  },
  "6": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "video/msch-demo",
      "format": "auto",
      "video": [
        "5",
        0
      ]
    }
  }
}